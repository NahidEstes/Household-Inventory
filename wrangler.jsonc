{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homely-inventory",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homely-inventory",
      "database_id": "1ffdea60-bbc4-4ec0-984a-54de039c29fe",
      "migrations_dir": "drizzle",
    },
  ],
}
